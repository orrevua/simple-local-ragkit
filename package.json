{
  "name": "ragkit",
  "version": "0.0.0",
  "description": "Local-first hybrid-RAG tool with a CLI and an MCP stdio server, running 100% offline on SQLite + Ollama.",
  "type": "module",
  "bin": {
    "ragkit": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "start": "node dist/cli/index.js",
    "ragkit": "node dist/cli/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "commander": "^14.0.2",
    "globby": "^14.1.0",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  }
}
